# Server
PORT=3001
CORS_ORIGINS=http://localhost:8080
# Set to 1 for auto-reload during local development (leave unset in production)
# RELOAD=1

# Auth (required, must be a long random string)
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_BOOTSTRAP_USERNAME=admin
# Set to false to close public signup: new accounts can then only be created
# by an admin. When no admin exists yet, only ADMIN_BOOTSTRAP_USERNAME is accepted.
ALLOW_PUBLIC_REGISTRATION=true

# AI quota
AI_DAILY_QUOTA=20

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional cost rates in USD per one million tokens (for cost reporting)
# DEEPSEEK_INPUT_COST_PER_MILLION=0.27
# DEEPSEEK_OUTPUT_COST_PER_MILLION=1.10

# Optional: OpenAI-compatible embedding API for RAG.
# If unset, a zero-dependency local hashing n-gram embedding is used.
# EMBEDDING_API_KEY=your_embedding_api_key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
