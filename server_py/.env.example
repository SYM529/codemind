# Server
PORT=3001
CORS_ORIGINS=http://localhost:8080
# Set to 1 for auto-reload during local development (leave unset in production)
# RELOAD=1

# Database driver: sqlite (default, zero-config) or mysql
# DB_DRIVER=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=codemind
# MYSQL_PASSWORD=change_me
# MYSQL_DATABASE=codemind

# Auth (required, must be a long random string)
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_BOOTSTRAP_USERNAME=admin
# Set to false to close public signup: new accounts can then only be created
# by an admin. When no admin exists yet, only ADMIN_BOOTSTRAP_USERNAME is accepted.
ALLOW_PUBLIC_REGISTRATION=true

# AI quota
AI_DAILY_QUOTA=20

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional cost rates in USD per one million tokens (for cost reporting)
# DEEPSEEK_INPUT_COST_PER_MILLION=0.27
# DEEPSEEK_OUTPUT_COST_PER_MILLION=1.10

# Optional: OpenAI-compatible embedding API for RAG.
# If unset, a zero-dependency local hashing n-gram embedding is used.
# EMBEDDING_API_KEY=your_embedding_api_key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# Project-level code understanding (ZIP upload). All values have sane defaults;
# uncomment only to override.
# NOTE: nginx client_max_body_size must be >= PROJECT_MAX_ZIP_BYTES. Defaults are 25m / 20MB.
# PROJECT_MAX_ZIP_BYTES=20971520
# PROJECT_MAX_TOTAL_UNCOMPRESSED_BYTES=125829120
# PROJECT_MAX_SINGLE_FILE_BYTES=1048576
# PROJECT_MAX_FILES=500
# PROJECT_MAX_ARCHIVE_ENTRIES=5000
# PROJECT_MAX_DEPTH=12
# PROJECT_MAX_COMPRESSION_RATIO=120
# PROJECT_MAX_CHUNKS=4000
# PROJECT_MAX_PER_USER=20
# PROJECT_MAX_CHUNK_LINES=60
# PROJECT_MAX_CHUNK_CHARS=4000
# PROJECT_INDEX_CONCURRENCY=2
# PROJECT_UPLOAD_RATE_LIMIT=5
# PROJECT_UPLOAD_RATE_WINDOW_SECONDS=60
# Unpacked working directory. Defaults to server_py/data/tmp, which lives inside
# the server-data volume in Docker, so stale directories survive a restart and
# can be swept on the next startup.
# PROJECT_UPLOAD_TMP_DIR=/app/data/tmp
# PROJECT_STALE_UPLOAD_HOURS=6

# Project Q&A: retrieval scope, context budget and rate limit per ask.
# QA shares the DeepSeek call chain and daily AI quota with single-file generation.
# PROJECT_QA_MAX_TOP_K=6
# PROJECT_QA_MAX_CONTEXT_CHARS=8000
# PROJECT_QA_RATE_LIMIT=10
# PROJECT_QA_RATE_WINDOW_SECONDS=60
